# Personal-System Environment Configuration

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Database location (default: personal.db)
DATABASE_PATH=personal.db

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Data and image storage directories
DATA_DIR=data
IMAGE_DIR=data/images
IMAGE_RETENTION_DAYS=30
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=80

# Workflow & Pending Items
PENDING_ITEM_TTL_HOURS=48
EDIT_SESSION_TTL_MINUTES=10
PENDING_REVIEW_TIME=21:00

# Optional: AI Configuration (Future phases)
# GEMINI_API_KEY=your_gemini_api_key_here
# DAILY_AI_REQUEST_LIMIT=50
# DAILY_AI_TOKEN_LIMIT=100000
