# Personal-System Environment Configuration

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database location (default: personal.db)
DATABASE_PATH=personal.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
LOG_FILE=logs/personal_system.log

# Storage and Media
DATA_DIR=data
IMAGE_DIR=data/images
IMAGE_RETENTION_DAYS=30
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=80

# Workflow & Pending Items
PENDING_ITEM_TTL_HOURS=48
EDIT_SESSION_TTL_MINUTES=10
PENDING_REVIEW_TIME=21:00

# ==================================================
# AI Providers & Model Routing (Phase 3)
# ==================================================
# Gemini API Key (Primary Multimodal & Reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
AI_FAST_MODEL=gemini-2.5-flash-lite
AI_DEFAULT_MODEL=gemini-2.5-flash
AI_ESCALATION_MODEL=gemini-3.8-flash
AI_ESCALATION_ENABLED=false

# Groq API Key (High-Speed Reasoning & Optional Vision Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_VISION_FALLBACK_ENABLED=false

# OpenRouter API Key (External Multi-Model Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Guardrails, Budgets & Timezone
AI_DAILY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_LIMIT=50000
TIMEZONE=Asia/Kolkata
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=20
